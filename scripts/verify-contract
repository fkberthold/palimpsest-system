#!/usr/bin/env bash
# =============================================================================
# verify-contract — check that this machine satisfies contract.md v3 §7.1
#
# Run this on palimpsest itself, AFTER install and first boot, BEFORE the
# container stack is set up. Everything it checks is the system layer's
# responsibility, so it should pass with no compose.yaml present at all.
#
#     sudo /opt/palimpsest-system/scripts/verify-contract
#
# Exit status is 0 only if every REQUIRED check passes. Checks marked [info] are
# reported but do not affect the exit status.
#
# The hardlink test at the end is the one that matters most. If it fails, the
# whole automation layer is broken in a way that will not announce itself:
# imports silently become full copies, disk usage doubles and seeding breaks.
# =============================================================================
set -uo pipefail

pass=0
fail=0
skip=0

ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$1"; pass=$((pass + 1)); }
no()   { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; fail=$((fail + 1)); }
note() { printf '  \033[33minfo\033[0m  %s\n' "$1"; skip=$((skip + 1)); }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$1"; }

# Compare "actual" against "expected" and report.
expect() { # expect <label> <expected> <actual>
  if [[ "$2" == "$3" ]]; then ok "$1 ($3)"; else no "$1 — expected '$2', got '$3'"; fi
}

printf '\033[1mpalimpsest — contract §7.1 verification\033[0m\n'
printf 'host: %s   date: %s\n' "$(hostname)" "$(date -Is)"

# Are we inside the test VM rather than on the real laptop? The VM has no Intel
# iGPU passed through, so GPU checks CANNOT pass there and reporting them as
# failures would train you to ignore red text. In a VM they are downgraded to
# informational; on real hardware they are hard failures.
virt="$(systemd-detect-virt 2>/dev/null || echo none)"
if [[ "$virt" != "none" ]]; then
  IN_VM=1
  printf 'virtualisation: %s — GPU checks will be informational only\n' "$virt"
else
  IN_VM=0
fi
# `no` on real hardware, `note` in a VM.
gpu_bad() { if [[ "$IN_VM" == "1" ]]; then note "$1"; else no "$1"; fi; }

# -----------------------------------------------------------------------------
hdr '§1  Identity — UIDs and GIDs the container stack hardcodes'
# -----------------------------------------------------------------------------
# The stack passes these to containers as PUID/PGID/group_add. If they drift,
# every file the stack writes gets the wrong owner.

expect "media uid"  "1500" "$(id -u  media 2>/dev/null || echo MISSING)"
expect "media gid"  "1500" "$(id -g  media 2>/dev/null || echo MISSING)"
expect "render gid" "303"  "$(getent group render | cut -d: -f3 2>/dev/null || echo MISSING)"
expect "frank uid"  "1000" "$(id -u  frank 2>/dev/null || echo MISSING)"

# media must not be able to log in.
media_shell="$(getent passwd media | cut -d: -f7)"
case "$media_shell" in
  *nologin|*false) ok "media shell is non-interactive ($media_shell)" ;;
  "")              no "media shell — user missing entirely" ;;
  *)               no "media shell — expected nologin, got '$media_shell'" ;;
esac

# -----------------------------------------------------------------------------
hdr '§2  Filesystem — ownership, modes, and the single-filesystem rule'
# -----------------------------------------------------------------------------

for d in /data /opt/palimpsest-stack; do
  if [[ -d "$d" ]]; then
    expect "$d owner/mode" "1500 1500 775" "$(stat -c '%u %g %a' "$d")"
  else
    no "$d does not exist"
  fi
done

# The full tree from contract §2.
for d in /data/media/movies /data/media/tv \
         /data/torrents/movies /data/torrents/tv \
         /data/usenet/incomplete /data/usenet/complete; do
  if [[ -d "$d" ]]; then
    expect "$d owner/mode" "1500 1500 775" "$(stat -c '%u %g %a' "$d")"
  else
    no "$d does not exist (systemd-tmpfiles should have created it)"
  fi
done

# --- The single-filesystem rule ---------------------------------------------
# /data and /data/media MUST be the same source device. A second mountpoint
# inside /data breaks hardlinking silently.
src_data="$(findmnt -no SOURCE --target /data 2>/dev/null)"
src_media="$(findmnt -no SOURCE --target /data/media 2>/dev/null)"
src_tor="$(findmnt -no SOURCE --target /data/torrents 2>/dev/null)"

if [[ -n "$src_data" && "$src_data" == "$src_media" && "$src_data" == "$src_tor" ]]; then
  ok "/data, /data/media and /data/torrents are one filesystem ($src_data)"
else
  no "/data is NOT a single filesystem — data=$src_data media=$src_media torrents=$src_tor"
fi

# Confirm /data is a real mount, not a directory on the root filesystem. This
# catches the case where the labelled disk failed to mount and `nofail` let the
# machine boot anyway.
if mountpoint -q /data; then
  ok "/data is a mountpoint (not a directory on /)"
else
  no "/data is NOT mounted — the palimpsest-data filesystem is missing. Check: findmnt /data; blkid | grep palimpsest-data"
fi

# --- The transcode tmpfs (the one permitted exception) -----------------------
if mountpoint -q /data/transcode; then
  tmpfs_type="$(findmnt -no FSTYPE /data/transcode)"
  tmpfs_size="$(findmnt -no SIZE   /data/transcode)"
  expect "/data/transcode fstype" "tmpfs" "$tmpfs_type"
  ok "/data/transcode size is $tmpfs_size (expect ~8G)"
  expect "/data/transcode owner/mode" "1500 1500 775" "$(stat -c '%u %g %a' /data/transcode)"
else
  no "/data/transcode is not mounted as tmpfs"
fi

# -----------------------------------------------------------------------------
hdr '§4  Hardware transcoding — VAAPI / QuickSync'
# -----------------------------------------------------------------------------

if [[ -e /dev/dri/renderD128 ]]; then
  ok "/dev/dri/renderD128 exists"
  # The render node must be group-owned by render(303) or the container's
  # group_add: 303 buys it nothing.
  rg="$(stat -c '%g' /dev/dri/renderD128)"; [[ "$rg" == "303" ]] && ok "renderD128 group (303)" || gpu_bad "renderD128 group — expected 303, got $rg; the container's group_add: 303 buys nothing without it"
else
  gpu_bad "/dev/dri/renderD128 missing — check BIOS is Hybrid/Optimus, not discrete-only"
fi

if command -v vainfo >/dev/null 2>&1; then
  vaout="$(vainfo 2>&1)"
  nprof="$(printf '%s' "$vaout" | grep -c VAProfile)"
  if [[ "$nprof" -gt 0 ]]; then
    ok "vainfo reports $nprof VAProfile entries"
    # iHD, not the legacy i965 driver (contract §4).
    if printf '%s' "$vaout" | grep -qi 'iHD'; then
      ok "driver is iHD"
    else
      gpu_bad "VAAPI is up but does not look like iHD — contract §4 requires intel-media-driver"
    fi
    # Encode support is the thing that actually matters for transcoding.
    printf '%s' "$vaout" | grep -q 'VAProfileH264.*EncSlice' \
      && ok "H264 hardware ENCODE available" \
      || gpu_bad "no H264 encode profile — transcoding will fall back to CPU"
    printf '%s' "$vaout" | grep -q 'VAProfileHEVCMain.*EncSlice' \
      && ok "HEVC hardware ENCODE available" \
      || note "no HEVC encode profile (decode-only is still usable)"
  else
    gpu_bad "vainfo returned no VAProfile lines — VAAPI is not working. Output was: $(printf '%s' "$vaout" | head -3)"
  fi
else
  gpu_bad "vainfo not installed (expected from libva-utils)"
fi

# -----------------------------------------------------------------------------
hdr 'Power — dGPU asleep, machine never sleeps'
# -----------------------------------------------------------------------------
# Not strictly contract §7, but this is the cheapest moment to catch it.

nvaddr="$(lspci -Dnn 2>/dev/null | grep -i nvidia | head -1 | cut -d' ' -f1)"
if [[ -n "$nvaddr" ]]; then
  pstate="$(cat "/sys/bus/pci/devices/$nvaddr/power_state" 2>/dev/null || echo unknown)"
  if [[ "$pstate" == "D3cold" ]]; then
    ok "dGPU at $nvaddr is in D3cold"
  else
    note "dGPU at $nvaddr is in $pstate, not D3cold — see NOTES.md 'The dGPU might not reach D3cold'. Costs ~10-15W, does not break anything."
  fi
  if lsmod | grep -q '^nouveau'; then
    no "nouveau is loaded despite being blacklisted"
  else
    ok "nouveau is not loaded"
  fi
else
  note "no NVIDIA device found by lspci"
fi

for t in sleep suspend hibernate hybrid-sleep suspend-then-hibernate; do
  state="$(systemctl is-enabled "$t.target" 2>&1 || true)"
  if [[ "$state" == "masked" ]]; then
    ok "$t.target is masked"
  else
    no "$t.target is '$state', expected masked"
  fi
done

lid="$(awk -F= '/^HandleLidSwitch=/{print $2}' /etc/systemd/logind.conf 2>/dev/null | head -1)"
[[ "$lid" == "ignore" ]] && ok "HandleLidSwitch=ignore" || no "HandleLidSwitch is '${lid:-unset}', expected ignore"

# -----------------------------------------------------------------------------
hdr '§3 / §5  Container runtime, stack unit, firewall'
# -----------------------------------------------------------------------------

systemctl is-active --quiet docker \
  && ok "docker is running" \
  || no "docker is not running"

# The unit must EXIST but not be wanted at boot (contract §3).
#
# NOTE ON `linked`: on NixOS, unit files live in /nix/store and are symlinked
# into /etc/systemd/system. For a unit with no [Install] section — which is
# exactly what `wantedBy = [ ]` produces — `systemctl is-enabled` reports
# **linked**, not `disabled`. Both mean "will not start at boot", which is what
# contract §3 asks for initially. Treating only `disabled` as a pass was a bug
# in this script, found by running it inside the test VM.
unit_state="$(systemctl is-enabled palimpsest-stack.service 2>&1 || true)"
case "$unit_state" in
  linked|disabled)
    ok "palimpsest-stack.service exists and will not start at boot (state: $unit_state) — as contract §3 requires initially" ;;
  enabled|enabled-runtime|linked-runtime)
    note "palimpsest-stack.service WILL start at boot (state: $unit_state) — correct once the stack works; deliberate?" ;;
  *)
    no "palimpsest-stack.service state is '$unit_state' — expected linked or disabled. Does the unit exist?" ;;
esac

# The compose file is owned by the OTHER repo. Its absence is expected and
# correct at this stage, so this is informational only.
if [[ -f /opt/palimpsest-stack/compose.yaml ]]; then
  if docker compose -f /opt/palimpsest-stack/compose.yaml config >/dev/null 2>&1; then
    ok "compose.yaml parses"
  else
    no "compose.yaml exists but does not parse"
  fi
else
  note "no compose.yaml yet — expected; that file belongs to the palimpsest-stack repo"
fi

# --- The stack unit's contract v2 §3 properties -----------------------------
# Read from the LIVE unit rather than the config, so this catches a machine
# running an older generation than the repo it was built from.
unit_after="$(systemctl show -p After --value palimpsest-stack.service 2>/dev/null || true)"
unit_mounts="$(systemctl show -p RequiresMountsFor --value palimpsest-stack.service 2>/dev/null || true)"
unit_pre="$(systemctl show -p ExecStartPre --value palimpsest-stack.service 2>/dev/null || true)"

for dep in docker.service network-online.target; do
  case " $unit_after " in
    *" $dep "*) ok "stack unit is ordered After=$dep" ;;
    *)          no "stack unit is missing After=$dep (contract v2 §3)" ;;
  esac
done

for m in /data /data/transcode /opt/palimpsest-stack; do
  case " $unit_mounts " in
    *" $m "*) ok "stack unit has RequiresMountsFor=$m" ;;
    *)        no "stack unit is missing RequiresMountsFor=$m (contract v2 §3)" ;;
  esac
done

# The bounded address wait. Without it the stack can start before DHCP has
# returned a lease, and every service binding an explicit LAN address fails.
if [[ -n "$unit_pre" ]]; then
  ok "stack unit has an ExecStartPre precondition"
else
  no "stack unit has no ExecStartPre — the LAN-address wait is missing"
fi

if command -v nft >/dev/null 2>&1; then
  if nft list table inet nixos-fw >/dev/null 2>&1; then
    ok "nftables firewall table is loaded"
    fw="$(nft list table inet nixos-fw 2>/dev/null)"

    # Contract v3 §5.1 — the LAN TCP rule covers ONLY host-bound services.
    #
    # 22 (sshd) and 8096 (host-networked Jellyfin) genuinely traverse INPUT, so
    # asserting them proves something.
    #
    # There is deliberately NO assertion for tcp/5055 here. It was asserted
    # under v2 and the assertion was worthless: Jellyseerr is Docker-published,
    # its traffic is DNAT'd in PREROUTING and never reaches INPUT, so the check
    # passed while proving nothing about whether Jellyseerr was reachable or
    # from where. A green check that means nothing is worse than no check,
    # because it spends the reader's trust. 5055 is verified by the `ss`
    # listener check in contract v3 §7.2 instead — see the note below.
    lan_tcp="$(printf '%s' "$fw" | grep '10.0.0.0/8' | grep 'tcp dport' || true)"
    if [[ -n "$lan_tcp" ]]; then
      ok "LAN (RFC1918) TCP rule is present"
      for p in 22 8096; do
        printf '%s' "$lan_tcp" | grep -qE "(\{|[ ,])$p(,| |\})" \
          && ok "  LAN rule covers tcp/$p" \
          || no "  LAN rule does NOT cover tcp/$p (contract v3 §5.1)"
      done
      # The inverse assertion: a Docker-published port appearing here means
      # someone has re-added an inert rule, which v3 removed on purpose.
      if printf '%s' "$lan_tcp" | grep -qE "(\{|[ ,])(5055|6767|7878|8080|8081|8989|9696)(,| |\})"; then
        no "  LAN rule names a Docker-published port — inert, and removed in v3. See contract §5.2."
      else
        ok "  LAN rule names no Docker-published ports (contract v3 §5.2)"
      fi
    else
      no "no RFC1918 TCP source rule in the ruleset (contract v3 §5.1)"
    fi

    # Contract v3 §5.1 — Jellyfin client auto-discovery, LAN only. These are
    # host networking, so unlike 5055 they really are enforced here. Without
    # them, Jellyfin can send discovery traffic but inbound probes are dropped
    # and clients must be pointed at an IP by hand.
    lan_udp="$(printf '%s' "$fw" | grep '10.0.0.0/8' | grep 'udp dport' || true)"
    if [[ -n "$lan_udp" ]]; then
      for p in 1900 7359; do
        printf '%s' "$lan_udp" | grep -qE "(\{|[ ,])$p(,| |\})" \
          && ok "  LAN rule covers udp/$p (discovery)" \
          || no "  LAN rule does NOT cover udp/$p (contract v3 §5.1)"
      done
    else
      no "no RFC1918 UDP discovery rule — Jellyfin auto-discovery will not work (contract v3 §5.1)"
    fi

    # No Tailscale in this design; assert its remnants are gone rather than
    # silently tolerating a stale rule.
    printf '%s' "$fw" | grep -q 'tailscale0' \
      && no "ruleset still references tailscale0 — Tailscale was removed from this design" \
      || ok "no stale tailscale0 rules"
  else
    no "inet nixos-fw table is not loaded — the firewall is not up"
  fi
fi

# Contract v3 §5.2 — a signpost, not a check. Nothing this script can run
# before the stack exists says anything about Docker-published exposure.
note "§5.2: Docker-published ports (5055, 6767, 7878, 8080, 8081, 8989, 9696) bypass this firewall entirely — DNAT in PREROUTING never reaches INPUT. They are NOT verified by this script and no rule here governs them."
note "  To verify those, after stack bring-up run the contract §7.2 listener check:  ss -ltnp | awk '\$4 !~ /^\\[/ {print \$4}' | sort -u"
note "  No Docker-published port may show 0.0.0.0: or *: — 5055 must appear twice (LAN addr + tailnet addr), the six admin UIs on the tailnet addr only."

# 22 and 8096 must NOT be reachable from a public source address. The RFC1918
# match is what enforces that, so assert the rules are source-scoped rather than
# blanket accepts — this is the thing standing between a router port-forward and
# an unintentionally public SSH port.
if printf '%s' "$fw" | grep -qE '^\s*tcp dport .*(22|8096)' ; then
  no "an UNSCOPED tcp accept for 22/8096 exists — those ports would be open to any source, including the internet once the router forwards"
else
  ok "22 and 8096 are source-scoped to RFC1918 (no blanket accept)"
fi

# -----------------------------------------------------------------------------
hdr 'THE IMPORTANT ONE — cross-directory hardlinking'
# -----------------------------------------------------------------------------
# Contract §7: "If it fails, the whole automation layer is broken in a way that
# will not announce itself."
#
# This writes into the real directories the *arr apps use, then cleans up.

link_src=/data/torrents/.verify-hardlink.$$
link_dst=/data/media/.verify-hardlink.$$
cleanup() { rm -f "$link_src" "$link_dst" 2>/dev/null || true; }
trap cleanup EXIT

if touch "$link_src" 2>/dev/null; then
  if ln "$link_src" "$link_dst" 2>/dev/null; then
    # Same inode == a true hardlink, not a copy.
    i1="$(stat -c '%i' "$link_src")"
    i2="$(stat -c '%i' "$link_dst")"
    if [[ "$i1" == "$i2" ]]; then
      ok "HARDLINK OK — /data/torrents -> /data/media share inode $i1"
    else
      no "ln succeeded but inodes differ ($i1 vs $i2) — this was a COPY, not a hardlink"
    fi
  else
    no "HARDLINK FAILED — /data/torrents and /data/media are not on the same filesystem. Every import will become a slow full copy and seeding will break."
  fi
else
  no "could not create a test file in /data/torrents (permissions? not mounted?)"
fi
cleanup
trap - EXIT

# -----------------------------------------------------------------------------
printf '\n\033[1m%d passed, %d failed, %d informational\033[0m\n' "$pass" "$fail" "$skip"
if [[ "$fail" -gt 0 ]]; then
  printf '\033[31mCONTRACT NOT SATISFIED\033[0m — fix the FAIL lines above before installing the stack.\n'
  exit 1
fi
printf '\033[32mContract satisfied.\033[0m The system layer is ready for palimpsest-stack.\n'
